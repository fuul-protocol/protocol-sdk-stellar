{
  "name": "@fuul-protocol/stellar-sdk",
  "version": "0.2.0-rc.8",
  "description": "Typed SDK for the Fuul protocol on Stellar",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "docs/api-guide.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "contracts.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/fuul-factory": {
      "types": "./dist/contracts/fuul-factory/index.d.ts",
      "import": "./dist/contracts/fuul-factory/index.js"
    },
    "./contracts/fuul-manager": {
      "types": "./dist/contracts/fuul-manager/index.d.ts",
      "import": "./dist/contracts/fuul-manager/index.js"
    },
    "./contracts/fuul-project": {
      "types": "./dist/contracts/fuul-project/index.d.ts",
      "import": "./dist/contracts/fuul-project/index.js"
    },
    "./amounts": {
      "types": "./dist/amounts.d.ts",
      "import": "./dist/amounts.js"
    },
    "./transactions": {
      "types": "./dist/transactions.d.ts",
      "import": "./dist/transactions.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "bun test ./test/",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:e2e": "node test-e2e/run.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.3.0",
    "@types/json-schema": "7.0.15",
    "@types/node": "22.19.17",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "overrides": {
    "uuid": "11.1.1"
  }
}
