{
  "name": "@fuul/sdk-stellar",
  "version": "0.2.0",
  "description": "Typed SDK for the Fuul protocol on Stellar",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuul-protocol/protocol-sdk-stellar.git"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs/api-guide.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "contracts.json"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./contracts/fuul-factory": {
      "import": {
        "types": "./dist/esm/contracts/fuul-factory/index.d.ts",
        "default": "./dist/esm/contracts/fuul-factory/index.js"
      },
      "require": {
        "types": "./dist/cjs/contracts/fuul-factory/index.d.ts",
        "default": "./dist/cjs/contracts/fuul-factory/index.js"
      }
    },
    "./contracts/fuul-manager": {
      "import": {
        "types": "./dist/esm/contracts/fuul-manager/index.d.ts",
        "default": "./dist/esm/contracts/fuul-manager/index.js"
      },
      "require": {
        "types": "./dist/cjs/contracts/fuul-manager/index.d.ts",
        "default": "./dist/cjs/contracts/fuul-manager/index.js"
      }
    },
    "./contracts/fuul-project": {
      "import": {
        "types": "./dist/esm/contracts/fuul-project/index.d.ts",
        "default": "./dist/esm/contracts/fuul-project/index.js"
      },
      "require": {
        "types": "./dist/cjs/contracts/fuul-project/index.d.ts",
        "default": "./dist/cjs/contracts/fuul-project/index.js"
      }
    },
    "./amounts": {
      "import": {
        "types": "./dist/esm/amounts.d.ts",
        "default": "./dist/esm/amounts.js"
      },
      "require": {
        "types": "./dist/cjs/amounts.d.ts",
        "default": "./dist/cjs/amounts.js"
      }
    },
    "./transactions": {
      "import": {
        "types": "./dist/esm/transactions.d.ts",
        "default": "./dist/esm/transactions.js"
      },
      "require": {
        "types": "./dist/cjs/transactions.d.ts",
        "default": "./dist/cjs/transactions.js"
      }
    },
    "./resources": {
      "import": {
        "types": "./dist/esm/resources.d.ts",
        "default": "./dist/esm/resources.js"
      },
      "require": {
        "types": "./dist/cjs/resources.d.ts",
        "default": "./dist/cjs/resources.js"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/esm/events.d.ts",
        "default": "./dist/esm/events.js"
      },
      "require": {
        "types": "./dist/cjs/events.d.ts",
        "default": "./dist/cjs/events.js"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/esm/adapters.d.ts",
        "default": "./dist/esm/adapters.js"
      },
      "require": {
        "types": "./dist/cjs/adapters.d.ts",
        "default": "./dist/cjs/adapters.js"
      }
    },
    "./lifecycle": {
      "import": {
        "types": "./dist/esm/lifecycle.d.ts",
        "default": "./dist/esm/lifecycle.js"
      },
      "require": {
        "types": "./dist/cjs/lifecycle.d.ts",
        "default": "./dist/cjs/lifecycle.js"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "bun test ./test/",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:e2e": "node test-e2e/run.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.3.0",
    "@types/json-schema": "7.0.15",
    "@types/node": "22.19.17",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
